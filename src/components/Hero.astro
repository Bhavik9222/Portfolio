---
const socials = [
  { href: 'https://www.linkedin.com/in/bhavik-merja-304430269', label: 'LinkedIn', icon: 'in' },
  { href: 'mailto:bhavikmerja9222@gmail.com', label: 'Email', icon: '✉' },
  { href: 'https://github.com/Bhavik9222', label: 'GitHub', icon: '◐' },
];
const avatar = `${import.meta.env.BASE_URL}/bhavik.jpg`;
---

<section id="home" class="hero">
  <div class="container hero-inner">
    <div class="avatar-wrap" aria-hidden="true">
      <div class="avatar-ring" />
      <div class="avatar-inner">
        <img src={avatar} alt="Bhavik Merja" class="avatar" width="172" height="172" onerror="this.style.opacity=0" />
      </div>
    </div>
    <p class="eyebrow"><span class="live" /> Net Square Solutions Pvt. Ltd.</p>
    <h1>Information <span class="gradient-text">Security Analyst</span></h1>
    <p class="lead">
      I'm <strong>Bhavik Merja</strong> — a Security Analyst with 1.5+ years of experience
      defending organizations through vulnerability assessment, penetration testing, and
      intelligent automation.
    </p>
    <div class="cta">
      <a href="#projects" class="btn btn-primary">View Engagements</a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>
    <div class="socials">
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener" title={s.label}><span class="s-icon">{s.icon}</span> {s.label}</a>)}
    </div>
  </div>
</section>

<style>
  .hero { padding: 96px 0 70px; }
  .hero-inner { max-width: 820px; text-align: center; }

  /* ---- Profile picture (top, center) ---- */
  .avatar-wrap {
    position: relative;
    width: 190px;
    height: 190px;
    margin: 0 auto 28px;
  }
  .avatar-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    padding: 6px;
    background: conic-gradient(from 0deg, var(--c1), var(--c2), var(--c3), var(--c4), var(--c1));
    -webkit-mask: linear-gradient(#000 0 0) content-box, #000 0 0;
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: spin 6s linear infinite;
    box-shadow: 0 0 40px var(--glow-2);
  }
  .avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--bg-soft);
    overflow: hidden;
    position: relative;
  }
  .avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .live {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--c1);
    box-shadow: 0 0 0 0 var(--glow-1);
    animation: pulse 2s infinite;
  }
  h1 {
    font-size: clamp(2.3rem, 6.5vw, 4.2rem);
    line-height: 1.05;
    margin: 0 0 22px;
    font-weight: 800;
    letter-spacing: -.02em;
  }
  .lead { color: var(--muted); font-size: 1.12rem; margin: 0 0 34px; }
  .lead strong { color: var(--text); }
  .cta { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .socials { display: flex; gap: 26px; margin-top: 32px; justify-content: center; flex-wrap: wrap; }
  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color .2s, transform .2s;
  }
  .socials a .s-icon {
    display: inline-grid;
    place-items: center;
    width: 26px; height: 26px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    font-size: 0.8rem;
    transition: transform .25s var(--ease), box-shadow .25s var(--ease);
  }
  .socials a:hover { color: var(--text); transform: translateY(-2px); }
  .socials a:hover .s-icon { transform: rotate(12deg); box-shadow: 0 6px 18px var(--glow-1); }

  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(34,211,238,.5); }
    70%  { box-shadow: 0 0 0 10px rgba(34,211,238,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,211,238,0); }
  }

  @media (max-width: 640px) {
    .avatar-wrap { width: 160px; height: 160px; }
  }
</style>
