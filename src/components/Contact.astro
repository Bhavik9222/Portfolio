---
const socials = [
  { href: 'https://www.linkedin.com/in/bhavik-merja-304430269', label: 'LinkedIn' },
  { href: 'mailto:bhavikmerja9222@gmail.com', label: 'Email' },
  { href: 'https://github.com/Bhavik9222', label: 'GitHub' },
];
---

<section id="contact" class="section reveal">
  <div class="container contact">
    <h2 class="section-title">Let's <span class="gradient-text">connect</span></h2>
    <p class="section-sub">
      Open to security engagements and collaborations. Reach out below.
    </p>
    <div class="contact-lines">
      <a href="mailto:bhavikmerja9222@gmail.com" class="contact-line">✉ bhavikmerja9222@gmail.com</a>
      <span class="contact-line">📞 +91 63531 21471</span>
    </div>
    <div class="cta">
      <a href="mailto:bhavikmerja9222@gmail.com" class="btn btn-primary">Email me</a>
      <a href="https://www.linkedin.com/in/bhavik-merja-304430269" target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn</a>
      <a href="/resume.pdf" class="btn btn-ghost" download>Resume</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <span>© <span id="year"></span> Bhavik Merja</span>
    <div class="socials">
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
    </div>
    <p class="foot-contact">bhavikmerja9222@gmail.com</p>
  </div>
</footer>

<script is:inline>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>

<style>
  .contact { text-align: center; }
  .contact-lines { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px; }
  .contact-line {
    color: var(--text);
    font-weight: 500;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.1);
    transition: border-color .2s, transform .2s;
  }
  a.contact-line:hover { border-color: var(--c3); transform: translateY(-2px); }
  .contact .cta { justify-content: center; display: flex; gap: 14px; flex-wrap: wrap; }

  .footer { border-top: 1px solid rgba(255,255,255,.06); padding: 26px 0; }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: var(--muted); font-size: 0.9rem; }
  .footer .socials { display: flex; gap: 18px; }
  .footer .socials a { color: var(--muted); }
  .footer .socials a:hover { color: var(--text); }
  .foot-contact { margin: 8px 0 0; font-size: 0.85rem; }
</style>
